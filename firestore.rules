// firestore.rules
// Regole di sicurezza Firestore per TonsilCare
//
// DEPLOY: firebase deploy --only firestore:rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper functions
    // -------------------------------------------------------------------------

    /** Verifica che l'utente sia autenticato */
    function isAuthenticated() {
      return request.auth != null;
    }

    /** Verifica che l'utente stia accedendo ai propri dati */
    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    /** Verifica che l'utente sia l'account che gestisce questo utente operato */
    function isUtenteAccount(utenteData) {
      return request.auth.uid == utenteData.accountId;
    }

    /** Verifica che l'utente abbia il ruolo di medico */
    function isMedico() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.ruolo == 'medico';
    }

    // -------------------------------------------------------------------------
    // /accounts/{uid} — Profilo genitore o medico
    // -------------------------------------------------------------------------
    match /accounts/{uid} {
      allow read: if isAuthenticated() && isOwner(uid);

      // Il proprietario aggiorna il proprio profilo, ma SOLO su questi campi.
      //
      // Senza l'elenco, `ruolo` era scrivibile dal client: un genitore poteva
      // promuoversi a medico scrivendo sul proprio documento, e da lì leggere
      // le schede e i diari di tutti i bambini e scrivere prescrizioni, perché
      // isMedico() legge esattamente questo campo. La promozione a medico
      // avviene da Console o Admin SDK, che non passano da queste regole.
      //
      // `updatedAt` è in elenco perché è metadato che accompagna qualsiasi
      // modifica di profilo; non concede privilegi.
      allow update: if isAuthenticated() && isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['nome', 'cognome', 'haRispostaMedicoNonLetta', 'updatedAt']);
      // Il medico può aggiornare SOLO il flag "risposta non letta" sull'account
      // di un genitore (mai sul proprio), per segnalare una nuova prescrizione.
      allow update: if isAuthenticated() && isMedico() && !isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['haRispostaMedicoNonLetta']);
      // La creazione avviene durante la registrazione (client)
      allow create: if isAuthenticated() && isOwner(uid);
      // La cancellazione è disabilitata (richiede Cloud Function)
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // /utenti/{utenteId} — Profilo utente operato
    // -------------------------------------------------------------------------
    match /utenti/{utenteId} {
      // L'account proprietario può leggere i propri, il medico può leggere tutti
      allow read: if isAuthenticated() && (isUtenteAccount(resource.data) || isMedico());
      // Solo l'account autenticato può creare un utente operato con il proprio UID
      allow create: if isAuthenticated()
        && request.resource.data.accountId == request.auth.uid;
      // L'account può aggiornare solo i propri utenti operati, e non può
      // riassegnarli: senza il vincolo su accountId, un genitore poteva
      // spostare un proprio paziente sotto un altro account.
      //
      // I campi faseOverride* sono esclusi: forzare la fase post-operatoria è
      // una decisione clinica del medico. Un genitore che potesse scriverli
      // rimetterebbe in piedi esattamente il problema che il calcolo automatico
      // ha risolto — una fase scelta a mano che non si aggiorna più — e da
      // quella fase dipende il piano alimentare che legge lui stesso.
      allow update: if isAuthenticated() && isUtenteAccount(resource.data)
        && request.resource.data.accountId == resource.data.accountId
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['faseOverride', 'faseOverrideMotivo', 'faseOverrideDa', 'faseOverrideIl']);
      // Il medico può aggiornare SOLO il flag "nuovo log non letto", per
      // azzerarlo quando apre la scheda di questo paziente.
      allow update: if isAuthenticated() && isMedico()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['haNuovoLogNonLetto']);
      // Il medico forza la fase post-operatoria, o toglie il forzamento.
      //
      // `faseOverrideDa` deve essere l'uid di chi sta scrivendo: senza questo
      // vincolo un medico potrebbe attribuire la decisione a un collega, e la
      // firma mostrata al genitore non varrebbe niente.
      //
      // Il secondo ramo copre la rimozione, dove i quattro campi vengono
      // cancellati e quindi `faseOverrideDa` non esiste nel documento in
      // arrivo: senza, togliere il forzamento sarebbe impossibile.
      allow update: if isAuthenticated() && isMedico()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['faseOverride', 'faseOverrideMotivo', 'faseOverrideDa', 'faseOverrideIl'])
        && (
          !('faseOverride' in request.resource.data)
          || request.resource.data.faseOverrideDa == request.auth.uid
        );
      // La cancellazione richiede che l'account sia il proprietario
      allow delete: if isAuthenticated() && isUtenteAccount(resource.data);

      // -----------------------------------------------------------------------
      // /utenti/{utenteId}/diario/{logId} — Log del diario (sotto-collezione)
      // -----------------------------------------------------------------------
      match /diario/{logId} {
        // Solo l'account dell'utente operato o il medico può leggere i log
        allow read: if isAuthenticated()
          && (get(/databases/$(database)/documents/utenti/$(utenteId)).data.accountId == request.auth.uid || isMedico());
        // Solo l'account può creare log per il proprio utente
        allow create: if isAuthenticated()
          && get(/databases/$(database)/documents/utenti/$(utenteId)).data.accountId == request.auth.uid
          && request.resource.data.createdByUid == request.auth.uid;
        // Un log inviato non si modifica e non si cancella: è la registrazione
        // di cosa è stato osservato in un dato momento, e il medico prende
        // decisioni su quei valori.
        //
        // L'update era aperto senza vincoli, in contraddizione con il delete
        // bloccato poche righe sotto per "audit trail": si poteva riscrivere un
        // 40.5°C dopo che il medico l'aveva letto, senza lasciare traccia.
        //
        // CHIUSO DELIBERATAMENTE, non per mancanza di casi d'uso: oggi non
        // esiste alcuna interfaccia di modifica. Va riaperto solo insieme al
        // design della correzione — entro quanto tempo si può correggere, e
        // come il medico vede che un valore è stato cambiato — non al primo
        // bisogno. Vedi CLAUDE.md.
        allow update: if false;
        allow delete: if false;
      }

      // -----------------------------------------------------------------------
      // /utenti/{utenteId}/prescrizioni/{prescId} — Prescrizioni mediche
      // -----------------------------------------------------------------------
      match /prescrizioni/{prescId} {
        // Medico e Genitore possono leggere le prescrizioni
        allow read: if isAuthenticated()
          && (get(/databases/$(database)/documents/utenti/$(utenteId)).data.accountId == request.auth.uid || isMedico());
        // Solo il medico può creare prescrizioni (con il proprio UID)
        allow create: if isMedico() && request.resource.data.medicoUid == request.auth.uid;
        // Modifica e cancellazione limitate al medico autore
        allow update, delete: if isMedico() && resource.data.medicoUid == request.auth.uid;
      }
    }

    // -------------------------------------------------------------------------
    // /fasi/{faseId} — Configurazione fasi (read-only per tutti gli autenticati)
    // Scritta solo dagli amministratori tramite Firebase Console o Admin SDK
    // -------------------------------------------------------------------------
    match /fasi/{faseId} {
      allow read: if isAuthenticated();
      allow write: if false; // Solo Admin SDK
    }

    // -------------------------------------------------------------------------
    // /config/{docId} — Configurazione medica (alerts, soglie, ecc.)
    // -------------------------------------------------------------------------
    match /config/{docId} {
      allow read: if isAuthenticated();
      allow write: if false; // Solo Admin SDK
    }

    // -------------------------------------------------------------------------
    // /ricette/{ricettaId} — Ricette (contenuto clinico, sola lettura al client)
    // Popolate da scripts/seed.mjs con Admin SDK, che non passa da queste regole.
    // -------------------------------------------------------------------------
    match /ricette/{ricettaId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // /info/{articleId} — Articoli informativi (idem: sola lettura al client)
    //
    // Erano entrambe `write: if isAuthenticated()` con un TODO mai chiuso, cioè
    // scrivibili e cancellabili da qualunque genitore registrato — comprese le
    // indicazioni su quando andare in pronto soccorso.
    // -------------------------------------------------------------------------
    match /info/{articleId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
  }
}
