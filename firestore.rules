// firestore.rules
// Regole di sicurezza Firestore per TonsilCare
//
// DEPLOY: firebase deploy --only firestore:rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper functions
    // -------------------------------------------------------------------------

    /** Verifica che l'utente sia autenticato */
    function isAuthenticated() {
      return request.auth != null;
    }

    /** Verifica che l'utente stia accedendo ai propri dati */
    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    /** Verifica che l'utente sia l'account che gestisce questo utente operato */
    function isUtenteAccount(utenteData) {
      return request.auth.uid == utenteData.accountId;
    }

    /** Verifica che l'utente abbia il ruolo di medico */
    function isMedico() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.ruolo == 'medico';
    }

    // -------------------------------------------------------------------------
    // /accounts/{uid} — Profilo genitore o medico
    // -------------------------------------------------------------------------
    match /accounts/{uid} {
      // Il proprietario può leggere e aggiornare il proprio profilo
      allow read, update: if isAuthenticated() && isOwner(uid);
      // Il medico può aggiornare SOLO il flag "risposta non letta" sull'account
      // di un genitore (mai sul proprio), per segnalare una nuova prescrizione.
      allow update: if isAuthenticated() && isMedico() && !isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['haRispostaMedicoNonLetta']);
      // La creazione avviene durante la registrazione (client)
      allow create: if isAuthenticated() && isOwner(uid);
      // La cancellazione è disabilitata (richiede Cloud Function)
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // /utenti/{utenteId} — Profilo utente operato
    // -------------------------------------------------------------------------
    match /utenti/{utenteId} {
      // L'account proprietario può leggere i propri, il medico può leggere tutti
      allow read: if isAuthenticated() && (isUtenteAccount(resource.data) || isMedico());
      // Solo l'account autenticato può creare un utente operato con il proprio UID
      allow create: if isAuthenticated()
        && request.resource.data.accountId == request.auth.uid;
      // L'account può aggiornare solo i propri utenti operati
      allow update: if isAuthenticated() && isUtenteAccount(resource.data);
      // Il medico può aggiornare SOLO il flag "nuovo log non letto", per
      // azzerarlo quando apre la scheda di questo paziente.
      allow update: if isAuthenticated() && isMedico()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['haNuovoLogNonLetto']);
      // La cancellazione richiede che l'account sia il proprietario
      allow delete: if isAuthenticated() && isUtenteAccount(resource.data);

      // -----------------------------------------------------------------------
      // /utenti/{utenteId}/diario/{logId} — Log del diario (sotto-collezione)
      // -----------------------------------------------------------------------
      match /diario/{logId} {
        // Solo l'account dell'utente operato o il medico può leggere i log
        allow read: if isAuthenticated()
          && (get(/databases/$(database)/documents/utenti/$(utenteId)).data.accountId == request.auth.uid || isMedico());
        // Solo l'account può creare log per il proprio utente
        allow create: if isAuthenticated()
          && get(/databases/$(database)/documents/utenti/$(utenteId)).data.accountId == request.auth.uid
          && request.resource.data.createdByUid == request.auth.uid;
        // Aggiornamento log (es. note aggiuntive)
        allow update: if isAuthenticated()
          && get(/databases/$(database)/documents/utenti/$(utenteId)).data.accountId == request.auth.uid;
        // I log non possono essere cancellati (audit trail medico)
        allow delete: if false;
      }

      // -----------------------------------------------------------------------
      // /utenti/{utenteId}/prescrizioni/{prescId} — Prescrizioni mediche
      // -----------------------------------------------------------------------
      match /prescrizioni/{prescId} {
        // Medico e Genitore possono leggere le prescrizioni
        allow read: if isAuthenticated()
          && (get(/databases/$(database)/documents/utenti/$(utenteId)).data.accountId == request.auth.uid || isMedico());
        // Solo il medico può creare prescrizioni (con il proprio UID)
        allow create: if isMedico() && request.resource.data.medicoUid == request.auth.uid;
        // Modifica e cancellazione limitate al medico autore
        allow update, delete: if isMedico() && resource.data.medicoUid == request.auth.uid;
      }
    }

    // -------------------------------------------------------------------------
    // /fasi/{faseId} — Configurazione fasi (read-only per tutti gli autenticati)
    // Scritta solo dagli amministratori tramite Firebase Console o Admin SDK
    // -------------------------------------------------------------------------
    match /fasi/{faseId} {
      allow read: if isAuthenticated();
      allow write: if false; // Solo Admin SDK
    }

    // -------------------------------------------------------------------------
    // /config/{docId} — Configurazione medica (alerts, soglie, ecc.)
    // -------------------------------------------------------------------------
    match /config/{docId} {
      allow read: if isAuthenticated();
      allow write: if false; // Solo Admin SDK
    }

    // -------------------------------------------------------------------------
    // /ricette/{ricettaId} — Ricette (read-only in prod, write per seeding)
    // -------------------------------------------------------------------------
    match /ricette/{ricettaId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); // TODO: rimettere a false dopo il seeding
    }

    // -------------------------------------------------------------------------
    // /info/{articleId} — Articoli informativi (read-only in prod, write per seeding)
    // -------------------------------------------------------------------------
    match /info/{articleId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); // TODO: rimettere a false dopo il seeding
    }
  }
}
