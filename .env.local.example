# Variabili d'ambiente Firebase — TonsilCare PWA
# Copia questo file in `.env.local` e sostituisci i valori con quelli del tuo progetto Firebase
# di SVILUPPO (mai quello di produzione — vedi CLAUDE.md, sezione "Firebase: dev vs produzione")
# NON committare .env.local su Git!

NEXT_PUBLIC_FIREBASE_API_KEY="tua-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="tuo-progetto-dev.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="tuo-progetto-dev"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="tuo-progetto-dev.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="tuo-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="tuo-app-id"
